# ============================================
# Configuration de la Base de Données
# ============================================
# Copiez ce fichier vers .env et remplissez vos informations
# cp env.example .env
# ou sur Windows: copy env.example .env

# Option 1: URL complète de la base de données (RECOMMANDÉ)
# Format: dialect://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Exemples pour différents types de bases de données:
# PostgreSQL: postgresql://user:pass@localhost:5432/mydb
# MySQL: mysql://user:pass@localhost:3306/mydb
# SQLite: sqlite:///path/to/database.db
# SQLite (mémoire): sqlite:///:memory:

# ============================================
# Option 2: Variables séparées (ALTERNATIVE)
# ============================================
# Utilisez cette option si vous préférez séparer les informations
# Ces variables sont utilisées uniquement si DATABASE_URL n'est pas défini

# Type de base de données (postgresql, mysql, sqlite, etc.)
DB_TYPE=postgresql

# Hôte de la base de données
DB_HOST=localhost

# Port de la base de données
DB_PORT=5432

# Nom d'utilisateur
DB_USER=user

# Mot de passe (laissez vide si aucun)
DB_PASSWORD=password

# Nom de la base de données
DB_NAME=dbname

# ============================================
# Notes
# ============================================
# - Si DATABASE_URL est défini, il a la priorité sur les variables séparées
# - Pour SQLite, seul DB_NAME (chemin du fichier) est nécessaire
# - Ne commitez JAMAIS le fichier .env dans Git (il est dans .gitignore)

